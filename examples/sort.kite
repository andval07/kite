// Insertion sort on a list, with a higher-order comparison.
fn sort(xs, less) {
  let i = 1;
  while i < len(xs) {
    let x = xs[i];
    let j = i - 1;
    while j >= 0 and less(x, xs[j]) {
      xs[j + 1] = xs[j];
      j = j - 1;
    }
    xs[j + 1] = x;
    i = i + 1;
  }
  return xs;
}

let nums = [5, 3, 9, 1, 7, 2];
print(sort(nums, fn(a, b) { return a < b; }));
print(sort(nums, fn(a, b) { return a > b; }));
